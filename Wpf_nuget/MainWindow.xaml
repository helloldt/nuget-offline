<Window x:Class="Wpf_nuget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_nuget"
        mc:Ignorable="d"
        Title="NuGet Package Manager" Height="700" Width="1200" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Window.Resources>
        <!-- 现代化按钮样式 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E9ECEF"/>
                                <Setter Property="BorderBrush" Value="#ADB5BD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DEE2E6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 主要按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007BFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                                <Setter Property="BorderBrush" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004085"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="15,10">
                <Button Name="btnRefresh" Content="🔄 刷新" Click="BtnRefresh_Click" 
                        Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0"/>
                <Rectangle Width="1" Fill="#E1E5E9" Margin="0,5"/>
                <Button Name="btnCleanup" Content="🗑️ 清理数据库" Click="BtnCleanup_Click" 
                        Style="{StaticResource ModernButtonStyle}" Margin="10,0"/>
                <Button Name="btnDbInfo" Content="ℹ️ 数据库信息" Click="BtnDbInfo_Click" 
                        Style="{StaticResource ModernButtonStyle}" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 搜索区域 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1" Margin="0">
            <Grid Margin="15,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                    <TextBox Name="txtSearch" Padding="12,8" FontSize="14" 
                             Text="" KeyDown="TxtSearch_KeyDown" 
                             VerticalContentAlignment="Center" BorderThickness="0" 
                             Background="Transparent"/>
                </Border>
                
                <Button Name="btnSearch" Grid.Column="1" Content="🔍 搜索" Click="BtnSearch_Click" 
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,15,0"/>
                
                <CheckBox Name="chkPrerelease" Grid.Column="2" Content="包含预发布版本" 
                          VerticalAlignment="Center" Margin="0,0,15,0" FontSize="13"
                          Checked="ChkPrerelease_Changed" Unchecked="ChkPrerelease_Changed"/>
                
                <Border Grid.Column="3" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4">
                    <ComboBox Name="cmbSearchSource" Padding="8" 
                              SelectedIndex="0" Width="120" BorderThickness="0" Background="Transparent"
                              SelectionChanged="CmbSearchSource_SelectionChanged">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="仅本地"/>
                        <ComboBoxItem Content="仅在线"/>
                    </ComboBox>
                </Border>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 包列表 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E1E5E9" BorderThickness="1" CornerRadius="6">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📦 包列表" FontSize="18" FontWeight="SemiBold" 
                               Foreground="#495057" Margin="0,0,0,15"/>
                
                    <ListView Name="lvPackages" Grid.Row="1" Margin="0,0,0,15" 
                              ItemsSource="{Binding Packages}"
                              SelectionChanged="LvPackages_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.ScrollChanged="LvPackages_ScrollChanged"
                              BorderThickness="0" Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLocalVersions}" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#007BFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="包名" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="版本" Width="100" DisplayMemberBinding="{Binding LatestVersion}"/>
                            <GridViewColumn Header="下载量" Width="80" DisplayMemberBinding="{Binding DownloadCount}"/>
                            <GridViewColumn Header="作者" Width="150" DisplayMemberBinding="{Binding Authors}"/>
                            <GridViewColumn Header="状态" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" 
                                                   Foreground="{Binding StatusColor}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                        <TextBlock Name="txtLoadingStatus" Text="" VerticalAlignment="Center" 
                                   Margin="0" FontSize="13" Foreground="#6C757D"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 包详情和版本管理 -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E1E5E9" BorderThickness="1" CornerRadius="6">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 包详情 -->
                    <TextBlock Grid.Row="0" Text="📋 包详情" FontSize="18" FontWeight="SemiBold" 
                               Foreground="#495057" Margin="0,0,0,15"/>
                
                <ScrollViewer Grid.Row="1" Margin="5" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlPackageDetails">
                        <TextBox Name="txtPackageId" FontWeight="Bold" FontSize="14" Margin="0,5" 
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                 TextWrapping="Wrap" Cursor="IBeam"/>
                        <TextBox Name="txtPackageTitle" FontSize="12" Margin="0,2" 
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                 TextWrapping="Wrap" Cursor="IBeam"/>
                        <TextBox Name="txtPackageAuthors" FontSize="10" Foreground="Gray" Margin="0,2" 
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                 TextWrapping="Wrap" Cursor="IBeam"/>
                        <TextBox Name="txtPackageDescription" TextWrapping="Wrap" Margin="0,5" 
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                 Cursor="IBeam"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="下载量: " FontWeight="Bold"/>
                            <TextBox Name="txtPackageDownloads" IsReadOnly="True" BorderThickness="0" 
                                     Background="Transparent" Cursor="IBeam"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="项目地址: " FontWeight="Bold"/>
                            <TextBox Name="txtPackageProjectUrl" Foreground="Blue" 
                                     MouseLeftButtonDown="TxtPackageProjectUrl_MouseLeftButtonDown" 
                                     Cursor="Hand" IsReadOnly="True" BorderThickness="0" 
                                     Background="Transparent"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="标签: " FontWeight="Bold"/>
                            <TextBox Name="txtPackageTags" TextWrapping="Wrap" IsReadOnly="True" 
                                     BorderThickness="0" Background="Transparent" Cursor="IBeam"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                    <!-- 版本列表 -->
                    <TextBlock Grid.Row="2" Text="📦 版本列表" FontSize="18" FontWeight="SemiBold" 
                               Foreground="#495057" Margin="0,15,0,15"/>
                    
                    <Grid Grid.Row="3" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView Name="lvVersions" Grid.Row="0" Margin="0,0,0,15"
                                  ItemsSource="{Binding Versions}"
                                  SelectionChanged="LvVersions_SelectionChanged"
                                  BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="8"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8F9FA"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#007BFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="版本" Width="100" DisplayMemberBinding="{Binding Version}"/>
                                    <GridViewColumn Header="发布时间" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Published, StringFormat=yyyy-MM-dd}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="状态" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" 
                                                           Foreground="{Binding StatusColor}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                            <Button Name="btnDownload" Content="⬇️ 下载" Click="BtnDownload_Click" 
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button Name="btnSync" Content="🔄 同步" Click="BtnSync_Click" 
                                    Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button Name="btnOpenFolder" Content="📁 打开文件夹" Click="BtnOpenFolder_Click" 
                                    Style="{StaticResource ModernButtonStyle}" Margin="0" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
            <StatusBar Background="Transparent" Height="30">
                <StatusBarItem>
                    <TextBlock Name="txtStatus" Text="就绪" FontSize="12" Foreground="#495057" Margin="10,0"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="txtPackageCount" Text="包数量: 0" Margin="10,0" FontSize="12" Foreground="#495057"/>
                        <TextBlock Name="txtDownloadedCount" Text="已下载: 0" Margin="10,0" FontSize="12" Foreground="#495057"/>
                        <TextBlock Name="txtServerUrl" Text="" Margin="10,0" Foreground="Blue" FontSize="12"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>
